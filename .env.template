# Base URL of the wawa-go API (no trailing slash)
API_BASE_URL=http://localhost:9000

# Must match PORTAL_ORIGIN in the wawa-go .env — the API rejects any non-GET
# request whose Origin header does not equal this value.
PORTAL_ORIGIN=http://localhost:3000

# Session cookie name issued by the wawa-go API
SESSION_COOKIE_NAME=wawa_session

# Meta / WhatsApp Embedded Signup
NEXT_META_APP_ID=
NEXT_META_EMBEDDED_SIGNUP_CONFIG_ID=
