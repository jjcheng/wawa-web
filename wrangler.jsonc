{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wawa-web",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/worker.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_META_APP_ID": "1389467986648945",
    "NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID": "1871010847640153",
    "COMMERCE_WEBSITE_DOMAIN": "wawago.app",
    "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY": "AIzaSyDS_T64TL2WaIeapcdk3mNhwiN9YslgLhs",
    "PORTAL_HOST": "portal.wawago.app"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
