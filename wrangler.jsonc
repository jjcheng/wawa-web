{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wawa-web",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/worker.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "vars": {
    "API_BASE_URL": "https://api.wawago.app",
    "COMMERCE_WEBSITE_DOMAIN": "wawago.app",
    "PORTAL_HOST": "portal.wawago.app",
    "SESSION_COOKIE_NAME": "wawago_session"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
